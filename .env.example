# SmartSync 环境变量配置模板
# 复制为 .env 并填入真实值

# ── MySQL ─────────────────────────────────────────────────
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=smartsync
MYSQL_PASSWORD=smartsync123
MYSQL_DB=smartsync

# ── JWT ───────────────────────────────────────────────────
SECRET_KEY=change-me-in-production-32-chars!

# ── LLM（OpenAI 兼容）───────────────────────────────────
LLM_API_KEY=sk-F3IjGiMYla9MwPyvhF3IjGiMYla9MwPyvh
LLM_BASE_URL=http://34.124.175.101:8371/v1
LLM_MODEL=gpt-4o-mini

# ── Whisper ───────────────────────────────────────────────
WHISPER_MODEL=base
# WHISPER_MODEL_PATH=/models/whisper-large-v3.pt  # 本地化部署时使用

# ── SMTP 邮件 ─────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM=SmartSync <noreply@smartsync.ai>

# ── 其他 ──────────────────────────────────────────────────
DEBUG=false

# Tingwu (Alibaba Cloud Offline Transcription)
TINGWU_ENABLED=false
TINGWU_ACCESS_KEY_ID=
TINGWU_ACCESS_KEY_SECRET=
TINGWU_APP_KEY=
TINGWU_ENDPOINT=tingwu.cn-beijing.aliyuncs.com
TINGWU_POLL_INTERVAL_SEC=8
TINGWU_POLL_TIMEOUT_SEC=3600
# Public URL prefix for uploaded files, e.g. https://your-domain.com/uploads
TINGWU_FILE_URL_BASE=

# Aliyun standard env aliases (optional, equivalent to TINGWU_ACCESS_KEY_ID/SECRET)
ALIBABA_CLOUD_ACCESS_KEY_ID=
ALIBABA_CLOUD_ACCESS_KEY_SECRET=
