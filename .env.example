# SmartSync 环境变量配置模板
# 复制为 .env 并填入真实值

# ── MySQL ─────────────────────────────────────────────────
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=smartsync
MYSQL_PASSWORD=
MYSQL_DB=smartsync

# ── JWT ───────────────────────────────────────────────────
SECRET_KEY=

# ── LLM（OpenAI 兼容）───────────────────────────────────
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=

# ── SMTP 邮件 ─────────────────────────────────────────────
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=SmartSync <noreply@example.com>

# ── 其他 ──────────────────────────────────────────────────
DEBUG=false
#听悟相关配置文档:https://help.aliyun.com/zh/tingwu/getting-started-1?spm=5176.28158887.0.0.69637yzu7yzuaH
# Tingwu (Alibaba Cloud Offline + Realtime Transcription)
TINGWU_ENABLED=true
TINGWU_ACCESS_KEY_ID=xxxxxxxxxxxxxxxx
TINGWU_ACCESS_KEY_SECRET=fLxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxoAmacA
TINGWU_APP_KEY=vqgxxxxxxxxxxx
TINGWU_ENDPOINT=tingwu.cn-beijing.aliyuncs.com
TINGWU_POLL_INTERVAL_SEC=8
TINGWU_POLL_TIMEOUT_SEC=14400
# Browser microphone capture for realtime transcription requires HTTPS or localhost.
# Offline recordings are uploaded to Cloudflare R2 before Tingwu processing.
# Use the account endpoint without the bucket suffix.
#cf开通R2对象存储
TINGWU_S3_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com
TINGWU_S3_BUCKET=https://1111111111111111111111111111111.r2.cloudflarestorage.com（改）
TINGWU_S3_REGION=auto
TINGWU_S3_USER_AGENT=SmartSync
# Leave empty for Tingwu; R2 native SigV4 presigned URLs are used.
TINGWU_S3_PUBLIC_URL_BASE=
TINGWU_S3_PREFIX=smartsync/tingwu
TINGWU_S3_URL_EXPIRES_SEC=14400
TINGWU_S3_ACCESS_KEY_ID=
TINGWU_S3_ACCESS_KEY_SECRET=

# Aliyun standard env aliases (optional, equivalent to TINGWU_ACCESS_KEY_ID/SECRET)
ALIBABA_CLOUD_ACCESS_KEY_ID=
ALIBABA_CLOUD_ACCESS_KEY_SECRET=
