# Docker gateway
APP_BIND_ADDRESS=0.0.0.0
APP_PORT=9090
TZ=Asia/Shanghai

# MySQL. Fill all password values before starting Compose.
MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_DB=smartsync
MYSQL_USER=smartsync
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=

# Initial administrator. Created only when ADMIN_USERNAME does not exist.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
ADMIN_NAME=Administrator
ADMIN_EMAIL=

# JWT
SECRET_KEY=

# Optional build mirrors and proxy. Leave proxy values empty when unused.
PIP_INDEX_URL=https://pypi.org/simple
NPM_REGISTRY=https://registry.npmjs.org
HTTP_PROXY=
HTTPS_PROXY=
NO_PROXY=localhost,127.0.0.1,mysql,backend,frontend,gateway

# OpenAI-compatible LLM. It can also be configured after login.
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=

# Alibaba Cloud Tingwu offline and realtime transcription
TRANSCRIPTION_ENABLED=true
TINGWU_ENABLED=false
TINGWU_ACCESS_KEY_ID=
TINGWU_ACCESS_KEY_SECRET=
TINGWU_APP_KEY=
TINGWU_ENDPOINT=tingwu.cn-beijing.aliyuncs.com
TINGWU_POLL_INTERVAL_SEC=8
TINGWU_POLL_TIMEOUT_SEC=14400

# Cloudflare R2 S3 API. The endpoint must not include the bucket name.
TINGWU_S3_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com
TINGWU_S3_BUCKET=
TINGWU_S3_REGION=auto
TINGWU_S3_USER_AGENT=SmartSync
TINGWU_S3_PUBLIC_URL_BASE=
TINGWU_S3_PREFIX=smartsync/tingwu
TINGWU_S3_URL_EXPIRES_SEC=14400
TINGWU_S3_ACCESS_KEY_ID=
TINGWU_S3_ACCESS_KEY_SECRET=

# Optional SMTP action-item delivery
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=SmartSync <noreply@example.com>

DEBUG=false
